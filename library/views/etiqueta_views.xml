<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="library_etiqueta_view_form" model="ir.ui.view">
        <field name="name">library.etiqueta.form</field>
        <field name="model">library.etiqueta</field>
        <field name="arch" type="xml">
            <form string="Etiqueta">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="library_etiqueta_view_list" model="ir.ui.view">
        <field name="name">library.etiqueta.list</field>
        <field name="model">library.etiqueta</field>
        <field name="arch" type="xml">
            <list string="Etiquetas">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="library_etiqueta_action" model="ir.actions.act_window">
        <field name="name">Etiquetas</field>
        <field name="res_model">library.etiqueta</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
